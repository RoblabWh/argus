POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb
DATABASE_URL=postgresql+psycopg2://user:password@db:5432/mydb
PORT_DB=5433
PORT_API=8008
PORT_FRONTEND=5173
HOST_REDIS=redis
PORT_REDIS=6379
OPEN_WEATHER_API_KEY=[your_open_weather_api_key_here]
VITE_API_URL=
ENABLE_WEBODM=false
WEBODM_PATH=
WEBODM_URL=
WEBODM_USERNAME=admin
WEBODM_PASSWORD=admin
ARGUS_OLLAMA_PORT=11434
LOG_LEVEL=WARNING
# --- Object re-identification (detection_yolo worker) ---
# The DINOv3 re-ID weights are license-gated on Hugging Face. The token is
# per DEPLOYMENT (one per ARGUS instance), not per webapp user — never commit
# or publish it. To get one (free): create a Hugging Face account, accept the
# model license on https://huggingface.co/facebook/dinov3-vitb16-pretrain-lvd1689m,
# then create a read access token at https://huggingface.co/settings/tokens.
# Can also be set later on the ARGUS settings page. Without it, detection still
# works — only re-identification is skipped (until the weights are cached).
HF_REID_MODEL_ID=facebook/dinov3-vitb16-pretrain-lvd1689m
HF_TOKEN=
# Published YOLO detection weights (public repo, no token required). Only
# override to test alternative weights for the "argus" model entry.
#ARGUS_YOLO_REPO_ID=RoblabWhGe/ARGUS-YOLO
#ARGUS_YOLO_FILENAME=argus_yolo11x_1280.pt
# GPU batch sizing: auto-sized from free VRAM (~75% target). Set YOLO_BATCH_SIZE
# to force a fixed inference batch, or tune the target fraction (0..1).
#YOLO_BATCH_SIZE=
#GPU_MEM_TARGET_FRACTION=0.75

# Default flags always passed to argus.sh / windows-argus.ps1 on launch.
# Example: ARGUS_DEFAULT_FLAGS=--update-all-urls to always rewrite URLs to the
# current local IP. Override on a one-off launch with --keep-urls /
# --keep-api-url / --keep-webodm-url. Leave empty for the default
# (preserve existing URLs once they have been written).
ARGUS_DEFAULT_FLAGS=